{
	"name": "misclickas-bingo-submissions",
	"main": "entry.mjs",
	"rules": [{ "type": "Text", "globs": ["**/*.svg"], "fallthrough": true }],
	"compatibility_date": "2026-09-12",
	"workers_dev": true,
	"vars": {
		"BOARD_PUBLIC": "false",
		"SIGNUPS_OPEN": "true",
		"GITHUB_OWNER": "Owl-Proxy",
		"GITHUB_REPO": "Misclickas-2026-spooky-bingo",
		"GITHUB_BRANCH": "submissions",
		"ALLOWED_ORIGINS": "https://owl-proxy.github.io,http://localhost:4173"
	},
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "UPLOAD_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "SIGNUP_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "SIGNUPS_DB",
			"database_name": "misclickas-bingo-signups",
			"database_id": "7d791663-175f-4c16-909f-130ad8d0a345",
			"migrations_dir": "migrations"
		}
	]
}
